<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'wf-flight-confirm-title'}"
                      MinSize="400 150">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
        <RichTextLabel Name="WarningLabel" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalAlignment="Right">
            <Button Name="DescendButton" Text="{Loc 'wf-flight-confirm-descend'}" StyleClasses="ButtonCaution" />
            <Button Name="AbortButton" Text="{Loc 'wf-flight-confirm-abort'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
