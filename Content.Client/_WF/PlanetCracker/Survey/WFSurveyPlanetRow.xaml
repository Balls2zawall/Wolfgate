<PanelContainer xmlns="https://spacestation14.io"
                HorizontalExpand="True">
    <!-- No PanelOverride here: the row builds its StyleBoxFlat from the active skin so no colour is ever a literal. -->
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6 4">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="NameLabel"
                   StyleClasses="LabelKeyText"
                   HorizontalExpand="True" />
            <Label Name="DistanceLabel"
                   StyleClasses="LabelSubText"
                   HorizontalAlignment="Right" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 2 0 0">
            <Label Name="StatusSanctioned"
                   StyleClasses="LabelSubText"
                   Margin="0 0 8 0" />
            <Label Name="StatusCracked"
                   StyleClasses="LabelSubText"
                   Margin="0 0 8 0" />
            <Label Name="StatusVeins"
                   StyleClasses="LabelSubText" />
        </BoxContainer>
        <Label Name="BeaconLabel"
               StyleClasses="LabelSubText"
               Margin="0 2 0 0" />
    </BoxContainer>
</PanelContainer>
